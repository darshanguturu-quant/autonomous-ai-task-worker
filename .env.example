# Copy this file to .env and fill in your key. .env is gitignored - never commit it.

# Required for scanned/image-only invoices (vision extraction).
# Text-native PDFs work without it. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the vision model (default: qwen/qwen3.6-27b).
# GROQ_MODEL=qwen/qwen3.6-27b

# Optional: change the port if 8000 is taken on your machine.
# PORT=8000
